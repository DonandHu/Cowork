Sub PartialMatchWithFind()
    Dim wsCurrent As Worksheet, wsTarget As Worksheet
    Dim lastRowCurrent As Long, lastRowTarget As Long
    Dim i As Long, foundCell As Range
    Dim searchValue As String
    
    ' 设置工作表对象
    Set wsCurrent = ActiveSheet ' 当前工作表
    Set wsTarget = ThisWorkbook.Sheets("Sheet2") ' 目标工作表
    
    ' 获取当前列的最后一行（假设数据从第1行开始）
    lastRowCurrent = wsCurrent.Cells(wsCurrent.Rows.Count, ActiveCell.Column).End(xlUp).Row
    lastRowTarget = wsTarget.Cells(wsTarget.Rows.Count, "A").End(xlUp).Row
    
    ' 遍历当前列的每个单元格
    For i = 1 To lastRowCurrent
        If wsCurrent.Cells(i, ActiveCell.Column).Value <> "" Then
            searchValue = wsCurrent.Cells(i, ActiveCell.Column).Value
            
            ' 在Sheet2的A列中查找部分匹配项
            Set foundCell = wsTarget.Range("A1:A" & lastRowTarget).Find( _
                What:=searchValue, _
                LookIn:=xlValues, _
                LookAt:=xlPart, _
                MatchCase:=False)
            
            ' 检查是否找到匹配项
            If Not foundCell Is Nothing Then
                ' 找到匹配项，可以在此处添加处理逻辑
                Debug.Print "行 " & i & " 的值 '" & searchValue & "' 在Sheet2的A列中找到部分匹配: " & foundCell.Value
                ' 例如：在相邻单元格标记匹配结果
                wsCurrent.Cells(i, ActiveCell.Column + 1).Value = "匹配: " & foundCell.Address
            Else
                wsCurrent.Cells(i, ActiveCell.Column + 1).Value = "无匹配"
            End If
        End If
    Next i
    
    MsgBox "部分匹配完成!"
End Sub
